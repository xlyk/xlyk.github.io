/* GitHub Dark Theme for Pelican Elegant
   Based on GitHub's official dark theme colors
   Clean, professional, and highly readable
*/

/* CSS Variables for GitHub Dark Theme */
:root {
  /* Core Background Colors */
  --bg-primary: #0d1117;         /* Main background */
  --bg-secondary: #161b22;       /* Card/section backgrounds */
  --bg-tertiary: #1c2128;        /* Hover states, subtle backgrounds */
  
  /* Border Colors */
  --border-color: #30363d;       /* All borders */
  --border-light: #21262d;       /* Subtle borders */
  
  /* Text Colors */
  --text-primary: #f0f6fc;       /* Headings, strong text */
  --text-secondary: #c9d1d9;     /* Body text */
  --text-muted: #8b949e;         /* Muted text, meta info */
  
  /* Accent Colors */
  --accent-primary: #58a6ff;     /* Links, primary accent */
  --accent-hover: #79c0ff;       /* Link hover state */
  --accent-secondary: #238636;   /* Success states, badges */
  --accent-warning: #d29922;     /* Warning states */
  --accent-danger: #f85149;      /* Error states */
  
  /* Code Colors */
  --code-text: #ff7b72;          /* Inline code text */
  --code-bg: rgba(110, 118, 129, 0.4); /* Inline code background */
  --code-block-bg: #161b22;      /* Code block background */
  
  /* Shadows for subtle depth */
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.12), 0 1px 2px rgba(0, 0, 0, 0.24);
  --shadow-md: 0 3px 6px rgba(0, 0, 0, 0.15), 0 2px 4px rgba(0, 0, 0, 0.12);
  
  /* Typography */
  --font-display: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', 'Helvetica Neue', sans-serif;
  --font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', 'Helvetica Neue', sans-serif;
  --font-mono: 'JetBrains Mono', 'SF Mono', Monaco, 'Cascadia Code', monospace;
}

/* Global transitions for smooth interactions */
* {
  transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}

/* Base body styling */
body {
  background-color: var(--bg-primary);
  color: var(--text-secondary);
  font-family: var(--font-body);
  line-height: 1.6;
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Main content area */
#content, .container, main {
  background-color: var(--bg-primary);
  color: var(--text-secondary);
}

/* Navigation bar - GitHub style */
.navbar, header, nav {
  background-color: var(--bg-secondary);
  border: none;
  border-bottom: 1px solid var(--border-color);
  box-shadow: none;
  margin-bottom: 2rem;
}

.navbar-inner {
  background: transparent;
  border: none;
  box-shadow: none;
}

.navbar .brand {
  color: var(--text-primary) !important;
  font-weight: 600;
  font-size: 1.25rem;
  text-shadow: none;
  letter-spacing: -0.5px;
}

.navbar .brand:hover {
  color: var(--accent-primary) !important;
  text-decoration: none;
}

/* Navigation links */
.navbar .nav > li > a {
  color: var(--text-secondary) !important;
  text-shadow: none;
  font-weight: 500;
  padding: 8px 12px;
  border-radius: 6px;
  margin: 2px;
  transition: all 0.15s ease;
}

.navbar .nav > li > a:hover,
.navbar .nav > .active > a {
  background-color: var(--bg-tertiary) !important;
  color: var(--accent-primary) !important;
  text-decoration: none;
}

/* Search bar */
.navbar-search .search-query {
  background-color: var(--bg-primary);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  border-radius: 6px;
  padding: 5px 12px;
  transition: all 0.15s ease;
}

.navbar-search .search-query:focus {
  background-color: var(--bg-primary);
  border-color: var(--accent-primary);
  outline: none;
  box-shadow: 0 0 0 2px rgba(88, 166, 255, 0.3);
}

.navbar-search .search-query::placeholder {
  color: var(--text-muted);
}

/* Headers */
h1, h2, h3, h4, h5, h6 {
  color: var(--text-primary);
  font-family: var(--font-display);
  font-weight: 600;
  letter-spacing: -0.5px;
  line-height: 1.25;
  margin-top: 24px;
  margin-bottom: 16px;
}

h1 {
  font-size: 2rem;
  padding-bottom: 0.3em;
  border-bottom: 1px solid var(--border-light);
}

h1 a, h2 a, h3 a {
  color: var(--accent-primary) !important;
}

h2 {
  font-size: 1.5rem;
  padding-bottom: 0.3em;
  border-bottom: 1px solid var(--border-light);
}

h3 {
  font-size: 1.25rem;
}

h4 {
  font-size: 1rem;
}

h5 {
  font-size: 0.875rem;
}

h6 {
  font-size: 0.85rem;
  color: var(--text-muted);
}

/* Links */
a {
  color: var(--accent-primary);
  text-decoration: none;
  transition: color 0.15s ease;
}

a:hover {
  color: var(--accent-hover);
  text-decoration: underline;
}

/* Article styling */
article, .article-content, .card, .post {
  background-color: var(--bg-primary);
  border: 1px solid var(--border-color);
  border-radius: 6px;
  padding: 16px;
  margin-bottom: 16px;
}

article:hover {
  border-color: var(--border-color);
}

/* Article metadata */
.meta, .post-meta, .article-meta, time {
  color: var(--text-muted);
  font-size: 0.875rem;
  margin-bottom: 8px;
}

/* Tags and categories */
.tag, .label, .badge {
  background-color: var(--bg-tertiary);
  color: var(--accent-primary);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 2px 8px;
  font-size: 0.75rem;
  font-weight: 500;
  display: inline-block;
  margin: 2px;
  transition: all 0.15s ease;
}

.tag:hover, .label:hover {
  background-color: var(--accent-secondary);
  color: #ffffff;
  border-color: var(--accent-secondary);
  text-decoration: none;
}

/* Code blocks */
pre, .highlight {
  background-color: var(--code-block-bg) !important;
  border: 1px solid var(--border-color);
  border-radius: 6px;
  color: #e6edf3;
  font-family: var(--font-mono);
  font-size: 0.875rem;
  padding: 16px;
  overflow-x: auto;
  margin: 16px 0;
}

code, tt {
  background-color: var(--code-bg);
  color: var(--code-text);
  padding: 0.2em 0.4em;
  border-radius: 3px;
  font-size: 85%;
}

pre code {
  padding: 0;
  background: transparent;
  color: inherit;
  border: none;
}

/* Blockquotes */
blockquote {
  border-left: 4px solid var(--border-color);
  background-color: var(--bg-secondary);
  padding: 0 1em;
  margin: 16px 0;
  color: var(--text-muted);
}

/* Tables */
table {
  background-color: var(--bg-primary);
  border: 1px solid var(--border-color);
  border-collapse: collapse;
  width: 100%;
  margin: 16px 0;
}

th {
  background-color: var(--bg-secondary);
  color: var(--text-primary);
  font-weight: 600;
  padding: 6px 13px;
  border: 1px solid var(--border-color);
}

td {
  padding: 6px 13px;
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
}

tr:nth-child(even) {
  background-color: var(--bg-secondary);
}

/* Footer */
footer {
  background-color: var(--bg-secondary);
  color: var(--text-muted);
  padding: 40px 0;
  margin-top: 40px;
  border-top: 1px solid var(--border-color);
}

footer a {
  color: var(--accent-primary);
}

footer a:hover {
  color: var(--accent-hover);
  text-decoration: underline;
}

/* Sidebar */
aside, .sidebar, #sidebar {
  background-color: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 6px;
  padding: 16px;
  margin-bottom: 16px;
}

.social-links a {
  color: var(--accent-primary);
}

.recent-posts li {
  border-bottom: 1px solid var(--border-light);
  padding: 8px 0;
}

.recent-posts a {
  color: var(--text-secondary);
}

.recent-posts a:hover {
  color: var(--accent-primary);
}

/* Pagination */
.pagination {
  margin: 16px 0;
}

.pagination a,
.pagination span {
  background-color: var(--bg-tertiary);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
  padding: 5px 10px;
  margin: 0 2px;
  border-radius: 3px;
  transition: all 0.15s ease;
}

.pagination a:hover {
  background-color: var(--accent-primary);
  color: #ffffff;
  border-color: var(--accent-primary);
  text-decoration: none;
}

.pagination .active {
  background-color: var(--accent-primary);
  color: #ffffff;
  border-color: var(--accent-primary);
}

/* Forms and inputs */
input[type="text"],
input[type="email"],
input[type="search"],
textarea,
select {
  background-color: var(--bg-primary);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  padding: 5px 12px;
  border-radius: 6px;
  font-size: 14px;
  transition: all 0.15s ease;
}

input[type="text"]:focus,
input[type="email"]:focus,
input[type="search"]:focus,
textarea:focus,
select:focus {
  background-color: var(--bg-primary);
  border-color: var(--accent-primary);
  outline: none;
  box-shadow: 0 0 0 2px rgba(88, 166, 255, 0.3);
}

/* Buttons */
.btn, button {
  background-color: var(--bg-tertiary);
  color: var(--text-primary);
  border: 1px solid var(--border-color);
  padding: 5px 16px;
  border-radius: 6px;
  font-weight: 500;
  font-size: 14px;
  transition: all 0.15s ease;
  cursor: pointer;
  display: inline-block;
}

.btn:hover, button:hover {
  background-color: var(--accent-primary);
  border-color: var(--accent-primary);
  color: #ffffff;
  text-decoration: none;
}

.btn-primary {
  background-color: var(--accent-secondary);
  border-color: var(--accent-secondary);
  color: #ffffff;
}

.btn-primary:hover {
  background-color: #2ea043;
  border-color: #2ea043;
}

/* Archive and category pages */
.archive-entry {
  padding: 12px 0;
  border-bottom: 1px solid var(--border-light);
}

.archive-entry:last-child {
  border-bottom: none;
}

/* Comments section */
#disqus_thread {
  background-color: var(--bg-secondary);
  padding: 16px;
  border-radius: 6px;
  margin-top: 24px;
  border: 1px solid var(--border-color);
}

/* Mobile responsive adjustments */
@media (max-width: 768px) {
  body {
    font-size: 15px;
  }
  
  h1 {
    font-size: 2rem;
  }
  
  h2 {
    font-size: 1.5rem;
  }
  
  article {
    padding: 1.5rem;
    border-radius: 8px;
  }
  
  .navbar .brand {
    font-size: 1.25rem;
  }
}

/* Elegant theme specific overrides */
#content-container {
  background-color: var(--bg-primary);
}

.elegant-article {
  background: transparent;
}

.elegant-title {
  color: var(--text-primary);
}

.elegant-subtitle {
  color: var(--text-muted);
}

/* Override Bootstrap defaults for dark theme */
.well {
  background-color: var(--bg-secondary);
  border: 1px solid var(--border-color);
}

.table {
  background-color: var(--bg-primary);
}

.table-striped tbody > tr:nth-child(odd) > td {
  background-color: var(--bg-secondary);
}

/* Smooth scrolling */
html {
  scroll-behavior: smooth;
}

/* Selection highlighting */
::selection {
  background-color: var(--accent-primary);
  color: var(--bg-primary);
}

::-moz-selection {
  background-color: var(--accent-primary);
  color: var(--bg-primary);
}

/* Scrollbar styling (webkit browsers) */
::-webkit-scrollbar {
  width: 12px;
  height: 12px;
}

::-webkit-scrollbar-track {
  background: var(--bg-secondary);
}

::-webkit-scrollbar-thumb {
  background: var(--border-color);
  border-radius: 6px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--accent-primary);
}

/* Simple fade animation */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

article {
  animation: fadeIn 0.3s ease;
}

/* Print styles */
@media print {
  body {
    background: white;
    color: black;
  }
  
  .navbar, footer, .sidebar {
    display: none;
  }
}